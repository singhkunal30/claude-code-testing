from fastapi.testclient import TestClient

from app.main import app

client = TestClient(app)


def test_list_{{resource_plural}}_empty() -> None:
    r = client.get("/{{resource_plural}}")
    assert r.status_code == 200
    assert isinstance(r.json(), list)


def test_create_and_get_{{resource_singular}}() -> None:
    r = client.post("/{{resource_plural}}", json={"name": "example"})
    assert r.status_code == 201
    created = r.json()
    assert created["name"] == "example"
    assert "id" in created

    r = client.get(f"/{{resource_plural}}/{created['id']}")
    assert r.status_code == 200
    assert r.json() == created


def test_get_missing_{{resource_singular}}_returns_404() -> None:
    r = client.get("/{{resource_plural}}/999999")
    assert r.status_code == 404
