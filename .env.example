# Copy this file to .env and fill in real values.
# .env is gitignored — never commit your real keys.

# Supabase project URL — find at https://app.supabase.com/project/<id>/settings/api
# Looks like: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Server-side key. STRONGLY prefer the service_role key for backend code:
# it bypasses Row-Level Security so we don't have to write policies for every
# table. NEVER expose this in client-side / browser code. Keep server-only.
# Find at: Settings → API → service_role (secret)
SUPABASE_KEY=

# Anon (public) key — used by GoTrue auth (signup/login) only.
# Find at: Settings → API → anon (public). Safe to expose to browsers.
SUPABASE_ANON_KEY=

# Optional: override schema. Defaults to "public".
# SUPABASE_SCHEMA=public
